generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  passwordHash  String    @map("password_hash")
  status        String    @default("active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  userRoles         UserRole[]
  tasks             Task[]
  nodeInstances     NodeInstance[]
  processInstances  ProcessInstance[]
  processDefinitions ProcessDefinition[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  apiKeys           ApiKey[]

  @@map("users")
}

model Role {
  id               String   @id @default(uuid())
  name             String   @unique
  description      String?
  permissions      Json     @default("[]")
  routePermissions Json     @default("[]") @map("route_permissions")
  createdAt        DateTime @default(now()) @map("created_at")

  userRoles     UserRole[]
  nodeInstances NodeInstance[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  scopeType String   @default("global") @map("scope_type")
  scopeId   String?  @map("scope_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scopeType, scopeId])
  @@map("user_roles")
}

model ProcessDefinition {
  id          String   @id @default(uuid())
  name        String
  version     Int      @default(1)
  graphJson   Json     @map("graph_json")
  status      String   @default("draft")
  description String?
  category    String?
  isTemplate  Boolean  @default(false) @map("is_template")
  isPreset    Boolean  @default(false) @map("is_preset")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  creator         User?               @relation(fields: [createdBy], references: [id])
  nodes           NodeDefinition[]
  processInstances ProcessInstance[]

  @@unique([name, version])
  @@map("process_definitions")
}

model NodeDefinition {
  id              String   @id @default(uuid())
  processId       String   @map("process_id")
  nodeName        String   @map("node_name")
  nodeType        String   @default("task") @map("node_type")
  inputSpec       Json     @map("input_spec")
  actionSpec      Json     @map("action_spec")
  outputSpec      Json     @map("output_spec")
  aiConfig        Json     @map("ai_config")
  progressConfig  Json     @map("progress_config")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  process       ProcessDefinition @relation(fields: [processId], references: [id], onDelete: Cascade)
  nodeInstances NodeInstance[]

  @@map("node_definitions")
}

model ProcessInstance {
  id              String    @id @default(uuid())
  definitionId    String    @map("definition_id")
  status          String    @default("running")
  plannedStartDate DateTime? @map("planned_start_date")
  actualStartDate DateTime? @map("actual_start_date")
  currentNodeId   String?   @map("current_node_id")
  createdBy       String    @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  definition    ProcessDefinition @relation(fields: [definitionId], references: [id])
  creator       User              @relation(fields: [createdBy], references: [id])
  nodeInstances NodeInstance[]

  @@map("process_instances")
}

model NodeInstance {
  id                String    @id @default(uuid())
  instanceId        String    @map("instance_id")
  definitionId      String    @map("definition_id")
  status            String    @default("waiting")
  plannedStartDate  DateTime? @map("planned_start_date")
  plannedEndDate    DateTime? @map("planned_end_date")
  actualStartDate   DateTime? @map("actual_start_date")
  actualEndDate     DateTime? @map("actual_end_date")
  percentComplete   Int       @default(0) @map("percent_complete")
  inputData         Json?     @map("input_data")
  outputData        Json?     @map("output_data")
  assigneeUserId    String?   @map("assignee_user_id")
  responsibleRoleId String?   @map("responsible_role_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  instance         ProcessInstance      @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  definition       NodeDefinition       @relation(fields: [definitionId], references: [id])
  assignee         User?                @relation(fields: [assigneeUserId], references: [id])
  responsibleRole  Role?                @relation(fields: [responsibleRoleId], references: [id])
  history          NodeInstanceHistory[]
  tasks            Task[]
  aiReports        AiReport[]
  aiAgentLogs      AiAgentLog[]

  @@map("node_instances")
}

model NodeInstanceHistory {
  id             String   @id @default(uuid())
  nodeInstanceId String   @map("node_instance_id")
  eventType      String   @map("event_type")
  actorUserId    String?  @map("actor_user_id")
  fromStatus     String?  @map("from_status")
  toStatus       String?  @map("to_status")
  details        Json?
  createdAt      DateTime @default(now()) @map("created_at")

  nodeInstance NodeInstance @relation(fields: [nodeInstanceId], references: [id], onDelete: Cascade)

  @@map("node_instance_history")
}

model Task {
  id             String    @id @default(uuid())
  nodeInstanceId String    @map("node_instance_id")
  assigneeUserId String    @map("assignee_user_id")
  type           String
  status         String    @default("pending")
  dueDate        DateTime? @map("due_date")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  nodeInstance NodeInstance @relation(fields: [nodeInstanceId], references: [id], onDelete: Cascade)
  assignee     User         @relation(fields: [assigneeUserId], references: [id])

  @@map("tasks")
}

model KnowledgeBase {
  id          String   @id @default(uuid())
  name        String
  mode        String   @default("rag")
  type        String
  description String?
  settings    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  documents   KnowledgeBaseDocument[]
  wikiSources WikiRawSource[]
  wikiPages   WikiPage[]

  @@map("knowledge_bases")
}

model KnowledgeBaseDocument {
  id               String   @id @default(uuid())
  knowledgeBaseId  String   @map("knowledge_base_id")
  fileName         String   @map("file_name")
  filePath         String   @map("file_path")
  fileSize         BigInt   @default(0) @map("file_size")
  mimeType         String?  @map("mime_type")
  parseStatus      String   @default("pending") @map("parse_status")
  vectorizedStatus String   @default("pending") @map("vectorized_status")
  chunkCount       Int      @default(0) @map("chunk_count")
  errorMessage     String?  @map("error_message")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks        DocumentChunk[]

  @@map("knowledge_base_documents")
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  chunkIndex Int      @map("chunk_index")
  content    String
  embedding  Unsupported("vector(1024)")?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  document KnowledgeBaseDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_chunks")
}

model WikiRawSource {
  id               String   @id @default(uuid())
  knowledgeBaseId  String   @map("knowledge_base_id")
  fileName         String   @map("file_name")
  filePath         String?  @map("file_path")
  fileSize         BigInt   @default(0) @map("file_size")
  mimeType         String?  @map("mime_type")
  converterMode    String   @default("markitdown") @map("converter_mode") // markitdown | mineru
  conversionStatus String   @default("pending") @map("conversion_status") // pending | processing | done | failed
  markdownContent  String?  @map("markdown_content")
  ingestStatus     String   @default("pending") @map("ingest_status") // pending | processing | done | failed
  errorMessage     String?  @map("error_message")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@map("wiki_raw_sources")
}

model WikiPage {
  id              String   @id @default(uuid())
  knowledgeBaseId String   @map("knowledge_base_id")
  slug            String
  title           String
  content         String
  pageType        String   @default("concept") @map("page_type") // concept | entity | source | index | log
  tags            String[]
  sourceFile      String?  @map("source_file")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@unique([knowledgeBaseId, slug])
  @@map("wiki_pages")
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

model AiAgentLog {
  id             String   @id @default(uuid())
  nodeInstanceId String?  @map("node_instance_id")
  role           String
  input          Json
  output         Json?
  latencyMs      Int?     @map("latency_ms")
  isFallback     Boolean  @default(false) @map("is_fallback")
  errorMessage   String?  @map("error_message")
  createdAt      DateTime @default(now()) @map("created_at")

  nodeInstance NodeInstance? @relation(fields: [nodeInstanceId], references: [id])

  @@map("ai_agent_logs")
}

model AiReport {
  id             String   @id @default(uuid())
  nodeInstanceId String   @map("node_instance_id")
  reportType     String   @map("report_type")
  content        Json
  createdAt      DateTime @default(now()) @map("created_at")

  nodeInstance NodeInstance @relation(fields: [nodeInstanceId], references: [id], onDelete: Cascade)

  @@map("ai_reports")
}

model AuditLog {
  id             String   @id @default(uuid())
  userId         String?  @map("user_id")
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  details        Json?
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Notification {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  type                String
  title               String
  content             String?
  channel             String    @default("in_app")
  status              String    @default("unread")
  relatedResourceType String?   @map("related_resource_type")
  relatedResourceId   String?   @map("related_resource_id")
  readAt              DateTime? @map("read_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AiProvider {
  id          String   @id @default(uuid())
  name        String   @unique
  type        String   // openai | azure_openai | anthropic | ollama | custom
  baseUrl     String?  @map("base_url")
  apiKey      String?  @map("api_key")
  isEnabled   Boolean  @default(true) @map("is_enabled")
  extra       Json     @default("{}") // extra config like api_version, org_id etc
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  models AiModel[]

  @@map("ai_providers")
}

model AiModel {
  id           String   @id @default(uuid())
  providerId   String   @map("provider_id")
  name         String
  modelId      String   @map("model_id")  // actual model name sent to API e.g. gpt-4o
  type         String   // chat | embedding | rerank
  isDefault    Boolean  @default(false) @map("is_default")
  contextWindow Int?    @map("context_window")
  maxTokens    Int?     @map("max_tokens")
  isEnabled    Boolean  @default(true) @map("is_enabled")
  extra        Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  provider  AiProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  agentRoles AgentRole[]
  fallbackChains ModelFallbackChain[]

  @@unique([providerId, modelId, type])
  @@map("ai_models")
}

model AgentSkill {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  type        String   // tool | retrieval | code_execution | custom
  config      Json     @default("{}")  // e.g. tool call schema, API endpoint etc
  isEnabled   Boolean  @default(true) @map("is_enabled")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  agentRoleSkills AgentRoleSkill[]

  @@map("agent_skills")
}

model AgentRole {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String?
  systemPrompt    String?  @map("system_prompt")
  modelId         String?  @map("model_id")
  temperature     Float    @default(0.7)
  maxTokens       Int?     @map("max_tokens")
  isEnabled       Boolean  @default(true) @map("is_enabled")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  model  AiModel?        @relation(fields: [modelId], references: [id])
  skills AgentRoleSkill[]

  @@map("agent_roles")
}

model AgentRoleSkill {
  id          String   @id @default(uuid())
  agentRoleId String   @map("agent_role_id")
  skillId     String   @map("skill_id")
  createdAt   DateTime @default(now()) @map("created_at")

  agentRole AgentRole  @relation(fields: [agentRoleId], references: [id], onDelete: Cascade)
  skill     AgentSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([agentRoleId, skillId])
  @@map("agent_role_skills")
}

/// Ordered fallback chain for a given model type (chat | embedding).
/// When the primary model call fails, the AI service will try models in ascending sortOrder.
model ModelFallbackChain {
  id        String   @id @default(uuid())
  modelType String   @map("model_type")  // 'chat' | 'embedding'
  sortOrder Int      @map("sort_order")
  modelId   String   @map("model_id")
  isEnabled Boolean  @default(true) @map("is_enabled")
  note      String?  // optional human-readable note
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  model AiModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelType, sortOrder])
  @@map("model_fallback_chains")
}

/// API keys for the AI Middle Platform (mode 3) — allows external systems to call skill-chat via OpenAI-compatible API
model ApiKey {
  id               String    @id @default(uuid())
  name             String
  keyHash          String    @unique @map("key_hash")
  keyPrefix        String    @map("key_prefix")        // displayed prefix e.g. "gf_sk_abc123"
  userId           String    @map("user_id")
  knowledgeBaseIds Json      @default("[]") @map("knowledge_base_ids")  // allowed KB scope
  agentRoleId      String?   @map("agent_role_id")
  usageCount       Int       @default(0) @map("usage_count")
  lastUsedAt       DateTime? @map("last_used_at")
  expiresAt        DateTime? @map("expires_at")
  isEnabled        Boolean   @default(true) @map("is_enabled")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}
